#!/usr/bin/python
import sys
import subprocess
import re
import argparse
import tomllib
import shutil
from pathlib import Path
import os
import time


with open('config.toml', 'rb') as fp:
    CONFIG = tomllib.load(fp)
for n in ('html', 'download'):
    CONFIG[n] = CONFIG[n].replace('$HOME', os.environ['HOME'])


PROMPT = f'''# この文章の日本語の誤字脱字を指摘してください。
- 構成などの助言は不要です
- 修正前、修正後のみを提示してください。
- 修正する時の書式は下記の例の様にgit mergeの書式に従って下さい。
- 「# 本文」以下のセクションが修正してほしい本文です。
- 特に修正が無いなら下記の例ではなく、空白を返してください。

# 例
<<<<<<<
このぽやりかたでは勝てません。
=======
このやりかたでは勝てません。
>>>>>>>

# 本文
'''


class MyHelpFormatter(argparse.RawDescriptionHelpFormatter):
    pass

parser = argparse.ArgumentParser(
    description='''将棋の本を書くためのプログラム。

このサイトで楽に本を書くための補助です。
https://shikenbisha.com/shogibookeditor/

まず、config.tomlを適当に書きます。
その上で例えばこうします。
ktfman watch
そして保存ボタンを押すとブラウザで印刷用のを表示してくれます。
''',

    formatter_class=MyHelpFormatter
)
parser.add_argument(
    'command', choices=('print', 'check', 'watch'),
    help='コマンド。print, check, watchの中からえらぶ。'
)
parser.add_argument('-n', '--num', type=int, default=0)
args = parser.parse_args()


class Command:
    def __init__(self):
        self._get_html()
        self.pages = self._translate_to_md()

    def _get_html(self):
        print(CONFIG['download'])
        if os.path.exists(CONFIG['download']):
            shutil.move(CONFIG['download'], CONFIG['html'])

    def print(self):
        subprocess.run([CONFIG['printer'], CONFIG['html']])

    def _translate_to_md(self):
        html = Path(CONFIG['html']).read_text()
        sep_html = '<section class="page ui-selectee">'
        sep = '====================NEWPAGE===================='
        html = html.replace(sep_html, sep_html+sep)
        task = subprocess.Popen(
            ['pandoc', '-t', 'markdown'],
            stdin = subprocess.PIPE,
            stdout = subprocess.PIPE
        )
        pages = task.communicate(html.encode())[0].decode()
        pages = re.sub(':.*?\n', '', pages)
        pages = pages.replace('`', '')
        pages = re.sub('{.*?}', '', pages, flags=re.DOTALL)
        pages = re.sub('<.*?>', '', pages, flags=re.DOTALL)
        return pages.split(sep)

    def check(self, num):
        task = subprocess.Popen(
            ['ollama', 'run', 'gemma4:26b-32k', '--think=false'],
            stdin = subprocess.PIPE,
            stdout = subprocess.PIPE
        )
        print(self.pages[num])
        return task.communicate((PROMPT+self.pages[num]).encode())[0].decode()

if args.command == 'print':
    Command().print()
elif args.command == 'check':
    if args.num == 0:
        print('ページ数を-nオプションでいれてください。')
        exit()
    print(Command().check(args.num)) 
elif args.command == 'watch':
    while True:
        time.sleep(1)
        if os.path.exists(CONFIG['download']):
            Command().print()
